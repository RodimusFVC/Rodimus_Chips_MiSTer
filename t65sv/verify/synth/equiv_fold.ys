# Formal check: fleet_sv with C02=1 (65C02 logic present, Mode tied 00) == C02=0 (no 65C02 logic)
read_verilog -sv ../../rtl/t65sv.sv ../../rtl/t65sv816.sv t65sv_T65_yosys.sv fleet_tops.sv
hierarchy -top fleet_sv -chparam C02 0
proc; flatten; opt_clean; async2sync; opt -full
rename fleet_sv gold
design -stash gold
read_verilog -sv ../../rtl/t65sv.sv ../../rtl/t65sv816.sv t65sv_T65_yosys.sv fleet_tops.sv
hierarchy -top fleet_sv -chparam C02 1
proc; flatten; opt_clean; async2sync; opt -full
rename fleet_sv gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
equiv_make gold gate equiv
hierarchy -top equiv
equiv_simple -seq 2
equiv_induct -seq 2
equiv_status -assert
